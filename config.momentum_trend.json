{
  "paper_trading": true,
  "poll_interval_seconds": 300,
  "log_file": "stb.log",
  "state_file": "state.json",
  "db_file": "stb_data.sqlite3",
  "position_size_usd": 300.0,
  "universe": {
    "mode": "momentum_top_n",
    "top_n": 100,
    "max_price": 30.00,
    "min_price": 1.00,
    "min_avg_volume": 1000000,
    "lookback_days": 30,
    "exchanges": ["NASDAQ", "NYSE", "AMEX"],
    "marginable_only": true
  },
  "strategy": {
    "name": "momentum_trend",
    "params": {
      "trend_filter_period": 200,
      "max_entry_vol_pct": 4.0,
      "entry_vol_period": 20,
      "momentum_period": 60,
      "min_momentum_pct": 20.0,
      "trailing_period": 20,
      "trailing_stop_pct": 0.10,
      "max_loss_pct": 0.08
    }
  }
}
