{
  "paper_trading": true,
  "poll_interval_seconds": 300,
  "log_file": "stb.log",
  "state_file": "state.json",
  "db_file": "stb_data.sqlite3",
  "position_size_usd": 300.0,
  "universe": {
    "mode": "momentum_top_n",
    "top_n": 100,
    "max_price": 30.00,
    "min_price": 1.00,
    "min_avg_volume": 1000000,
    "lookback_days": 30,
    "exchanges": ["NASDAQ", "NYSE", "AMEX"],
    "marginable_only": true
  },
  "strategy": {
    "name": "mean_reversion",
    "params": {
      "trend_filter_period": 200,
      "rsi_period": 14,
      "oversold_threshold": 48.0,
      "exit_rsi_threshold": 70.0,
      "take_profit_pct": 0.02,
      "max_loss_pct": 0.08
    }
  }
}
